# Variables d'environnement de l'API SCOLIA sur Render
# (Render > Service > Environment — valeurs à recopier depuis Supabase).
#
# Secrets à NE JAMAIS entreposer dans le dépôt ou côté navigateur :
# SUPABASE_SERVICE_ROLE_KEY.

SUPABASE_URL=https://<project-ref>.supabase.co

# Clé service_role (Dashboard > Project Settings > API Keys > secret API key).
# Elle permet de contourner la RLS : service_role UNIQUEMENT côté serveur.
SUPABASE_SERVICE_ROLE_KEY=

# Origine(s) du front admises en CORS, séparées par une virgule. En
# production, TOUJOURS renseignée (sinon toutes les origines passent).
FRONTEND_ORIGIN=https://votre-front.onrender.com
