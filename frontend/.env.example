# Front — uniquement les clés publiques (jamais de service_role côté navigateur)
#
# VITE_SUPABASE_ANON_KEY : la clé « publishable » du projet
# (Dashboard > Project Settings > API Keys > Publishable and secret API keys),
# de la forme sb_publishable_… Elle est faite pour le navigateur : c'est la
# RLS qui protège les tables. L'ancienne clé anon JWT (eyJ…) est rejetée par
# le gateway des Edge Functions (« Invalid JWT »).
#
# Base de données hébergée : recopier l'URL du projet Supabase
# (Dashboard > Project Settings > General > Reference > Project URL).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Le secret de signature du webhook de paiement N'EST PAS une variable VITE_* :
# il ne doit jamais entrer dans le bundle du navigateur. Il est propre au
# serveur (Edge Functions) et, en développement, au poste qui appelle le
# webhook (backend/scripts/confirm-sandbox-payment.mjs).
# SCOLIA_WEBHOOK_SECRET=scolia-dev-secret   <- secret SIDE SERVEUR (poste de dev)

# Côté serveur uniquement : secrets gérés par Supabase (Dashboard > Edge Functions > Secrets)
# SUPABASE_SERVICE_ROLE_KEY   — injectée automatiquement par Supabase dans les Edge Functions
# PAYMENT_WEBHOOK_SECRET      — secret HMAC du webhook de paiement (sandbox / prestataire)
# PAYMENT_PROVIDER_API_KEY    — clé API de l'agrégateur choisi (PayDunya / CinetPay)
# NOTIFIER_*                  — clés SMS/WhatsApp/e-mail (phase relances)
