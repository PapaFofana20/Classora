# Front — uniquement les clés publiques (jamais de service_role côté navigateur)
#
# VITE_SUPABASE_ANON_KEY : la clé « publishable » du projet
# (Dashboard > Project Settings > API Keys > Publishable and secret API keys),
# de la forme sb_publishable_… Elle est faite pour le navigateur : c'est la
# RLS qui protège les tables.
#
# Base de données hébergée : recopier l'URL du projet Supabase
# (Dashboard > Project Settings > General > Reference > Project URL).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# API backend hébergée sur Render (fonctions privilégiées : inscriptions,
# gestion du personnel, paiements). En dev : http://localhost:3000
# (backend/api — `npm run dev`). VITE_SUPABASE_URL reste utilisée pour la
# base et l'Auth (lectures directes sous RLS + sessions).
VITE_API_URL=https://scolia-api.onrender.com

# Le secret de signature du webhook de paiement N'EST PAS une variable VITE_* :
# il ne doit jamais entrer dans le bundle du navigateur. Il vit sur Render
# (Environment > SCOLIA_WEBHOOK_SECRET) et, en développement, au poste qui
# appelle le webhook (backend/scripts/confirm-sandbox-payment.mjs).

# Côté Render uniquement (backend/api > Environment) :
# SUPABASE_URL                — URL du projet Supabase
# SUPABASE_SERVICE_ROLE_KEY   — clé serveur (jamais au navigateur)
# SCOLIA_WEBHOOK_SECRET       — secret HMAC du webhook de paiement
# FRONTEND_ORIGIN             — origine du front admise en CORS
# APP_ENV=sandbox             — uniquement en développement/tests
